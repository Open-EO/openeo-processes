{
  "id": "array_filter",
  "level": "L3",
  "tests": [
    {
      // empty array
      "required": [
        "gt"
      ],
      "arguments": {
        "data": [],
        "condition": {
          "process_graph": {
            "gt": {
              "process_id": "gt",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": 3
              },
              "result": true
            }
          }
        }
      },
      "returns": []
    },
    {
      // single comparison process applied to a normal array
      "required": [
        "gt"
      ],
      "arguments": {
        "data": [
          1,
          -2,
          3.5,
          -4.725,
          NaN
        ],
        "condition": {
          "process_graph": {
            "gt": {
              "process_id": "gt",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": 1
              },
              "result": true
            }
          }
        }
      },
      "returns": [
        3.5
      ]
    },
    {
      // handle index from a normal array
      "required": [
        "lte"
      ],
      "arguments": {
        "data": [
          1,
          2,
          3,
          4
        ],
        "condition": {
          "process_graph": {
            "lte": {
              "process_id": "lte",
              "arguments": {
                "x": {
                  "from_parameter": "index"
                },
                "y": 2
              },
              "result": true
            }
          }
        }
      },
      "returns": [
        1,
        2,
        3
      ]
    },
    {
      // handle label from a labeled array
      "required": [
        "eq"
      ],
      "arguments": {
        "data": {
          "type": "labeled-array",
          "data": [
            {
              "key": "B01",
              "value": 1.23
            },
            {
              "key": "B02",
              "value": 0.98
            }
          ]
        },
        "condition": {
          "process_graph": {
            "eq": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_parameter": "label"
                },
                "y": "B02"
              },
              "result": true
            }
          }
        }
      },
      "returns": {
        "type": "labeled-array",
        "data": [
          {
            "key": "B02",
            "value": 0.98
          }
        ]
      }
    },
    {
      // handle index from a labeled array
      "required": [
        "eq"
      ],
      "arguments": {
        "data": {
          "type": "labeled-array",
          "data": [
            {
              "key": "B01",
              "value": 1.23
            },
            {
              "key": "B02",
              "value": 0.98
            }
          ]
        },
        "condition": {
          "process_graph": {
            "eq": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_parameter": "index"
                },
                "y": 0
              },
              "result": true
            }
          }
        }
      },
      "returns": {
        "type": "labeled-array",
        "data": [
          {
            "key": "B01",
            "value": 1.23
          }
        ]
      }
    },
    {
      // single comparison process applied to a labeled array
      "required": [
        "gt"
      ],
      "arguments": {
        "data": {
          "type": "labeled-array",
          "data": [
            {
              "key": "B01",
              "value": 1.23
            },
            {
              "key": "B02",
              "value": 0.98
            }
          ]
        },
        "condition": {
          "process_graph": {
            "gt": {
              "process_id": "gt",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": 1
              },
              "result": true
            }
          }
        }
      },
      "returns": {
        "type": "labeled-array",
        "data": [
          {
            "key": "B01",
            "value": 1.23
          }
        ]
      }
    },
    {
      // apply multiple comparison processes to a normal array
      "required": [
        "lt",
        "gt",
        "or"
      ],
      "arguments": {
        "data": [
          1,
          -2,
          3.5,
          -4.725,
          NaN
        ],
        "condition": {
          "process_graph": {
            "lt": {
              "process_id": "lt",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": -2
              }
            },
            "gt": {
              "process_id": "gt",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": 2
              }
            },
            "or": {
              "process_id": "or",
              "arguments": {
                "x": {
                  "from_node": "lt"
                },
                "y": {
                  "from_node": "gt"
                }
              },
              "result": true
            }
          }
        }
      },
      "returns": [
        3.5,
        -4.725
      ]
    }
  ]
}
