            "reference_system": "EPSG:25832"
          }
        },
        "data": [
          [
            [172, 47, 117, 192],
            [67, 251, 195, 103],
            [9, 211, 255, 242]
          ],
          [
            [174, 88, 81, 255],
            [25, 77, 72, 9],
            [148, 115, 255, 208]
          ]
        ]
      }
    },
    {
      "arguments": {
        "data": {
          "$ref": "assets/xyb-minimal-int.json5"
        },
        "bands": [
          "red",
          "blue"
        ]
      },
      "returns": {
        "type": "datacube",
        "nodata": 255,
        "order": ["bands", "y", "x"],
        "dimensions": {
          "bands": {
